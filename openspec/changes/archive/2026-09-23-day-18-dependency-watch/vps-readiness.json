      "description": "Schedule finite Google Maven checks; every accepted call creates a NEW watch.\n\n        No retry or idempotent-create guarantee. max_runs includes failures. Normally\n        interval_seconds >= 3600; short demo intervals require server configuration.\n        Creation only persists a schedule; it does not perform a lookup.\n        ",
      "inputSchema": {
        "properties": {
          "group_id": {
            "description": "Exact Google Maven group, for example androidx.core",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9_][A-Za-z0-9_-]*)*$",
            "title": "Group Id",
            "type": "string"
          },
          "artifact_id": {
            "description": "Exact artifact, for example core-ktx; not a URL",
            "maxLength": 256,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$",
            "title": "Artifact Id",
            "type": "string"
          },
          "max_runs": {
            "description": "Finite number of runs, including failures",
            "maximum": 100,
            "minimum": 1,
            "title": "Max Runs",
            "type": "integer"
          },
          "interval_seconds": {
            "default": 21600,
            "description": "Seconds between checks; normally at least 3600; default 21600",
            "maximum": 86400,
            "minimum": 30,
            "title": "Interval Seconds",
            "type": "integer"
          }
        },
        "required": [
          "group_id",
          "artifact_id",
          "max_runs"
        ],
